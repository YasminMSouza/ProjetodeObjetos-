    {
        "id": "8e60f952739f496d",
        "type": "function",
        "z": "54a36a02f6c6c903",
        "name": "influx",
        "func": "let d_max = 25;  // cm — calibrar na instalação (comedouro vazio)\n\nlet temp = parseFloat(msg.payload.temperatura);\nlet dist = parseFloat(msg.payload.distancia);\n\nif (isNaN(temp) || isNaN(dist)) return null;\n\nlet nivel = (1 - dist / d_max) * 100;\nnivel = Math.max(0, Math.min(100, nivel));  // trava entre 0 e 100\n\nmsg.payload = [{\n    temperatura: temp,\n    nivel_racao: nivel,\n    distancia: dist\n}];\nreturn msg;",
