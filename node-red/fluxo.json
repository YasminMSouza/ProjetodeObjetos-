    {
        "id": "9bd9bd84a57bf0d6",
        "type": "function",
        "z": "54a36a02f6c6c903",
        "name": "alerta",
        "func": "let d_max = 25;  // mesmo valor da função 1\n\nlet temp = parseFloat(msg.payload.temperatura);\nlet dist = parseFloat(msg.payload.distancia);\nif (isNaN(temp) || isNaN(dist)) return null;\n\nlet nivel = (1 - dist / d_max) * 100;\nnivel = Math.max(0, Math.min(100, nivel));\n\n// fora da faixa segura?\nlet alertaTemp   = (temp > 33 || temp < 10);\nlet alertaRacao  = (nivel < 20);\n\nlet antTemp  = context.get(\"antTemp\")  || false;\nlet antRacao = context.get(\"antRacao\") || false;\ncontext.set(\"antTemp\", alertaTemp);\ncontext.set(\"antRacao\", alertaRacao);\n\nlet mensagens = [];\n\n// só quando ENTRA em alerta (borda de subida)\nif (alertaTemp && !antTemp) {\n    mensagens.push(`🚨 Temperatura ${temp.toFixed(1)}°C - risco ao animal!`);\n}\nif (alertaRacao && !antRacao) {\n    mensagens.push(`🍽️ Ração em ${nivel.toFixed(0)}% - reabasteça o comedouro!`);\n}\n\nif (mensagens.length === 0) return null;  // nada muda, não envia\n\nmsg.payload = { text: \"Casinha do pet:\\n\" + mensagens.join(\"\\n\") };\nreturn msg;",
